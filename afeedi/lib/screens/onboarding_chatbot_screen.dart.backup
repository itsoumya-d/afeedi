}

class OnboardingChatbotScreen extends StatefulWidget {
  const OnboardingChatbotScreen({super.key});

  @override
  State<OnboardingChatbotScreen> createState() => _OnboardingChatbotScreenState();
}

class _OnboardingChatbotScreenState extends State<OnboardingChatbotScreen>
    with TickerProviderStateMixin {
  late AnimationController _fadeController;
  late AnimationController _slideController;
  late AnimationController _typingController;
  late Animation<double> _fadeAnimation;
  late Animation<Offset> _slideAnimation;
  late Animation<double> _typingAnimation;

  final ScrollController _scrollController = ScrollController();
  final TextEditingController _textController = TextEditingController();
  final FocusNode _textFocusNode = FocusNode();
  late TextEditingController _searchController;
  late FocusNode _searchFocusNode;
  final List<ChatMessage> _messages = [];
  final List<String> _quickReplies = [];
  final Map<int, String> _userPreferences = {};
  bool _showQuickReplies = false;
  bool _showTyping = false;
  bool _showFinalButton = false;
  bool _showTextInput = false;
  Set<String> _selectedGenres = {};
  List<Genre> _filteredGenres = [];
  bool _showGenreSelection = false;
  bool _showWelcomeScreen = true;
  String _searchQuery = '';
  
  // Gamification elements
  List<String> _unlockedAchievements = [];
  bool _showAchievementPopup = false;
  String _currentAchievement = '';
  int _experiencePoints = 0;
  
  // Contextual help
  bool _showTooltip = false;
  String _tooltipText = '';
  GlobalKey _tooltipKey = GlobalKey();

  // Genre data with emojis
  final List<Genre> _allGenres = [
    // Educational
    Genre(name: 'Science & Technology', emoji: '🔬', category: 'Educational', keywords: ['science', 'tech', 'technology', 'research', 'innovation']),
    Genre(name: 'Business & Finance', emoji: '💼', category: 'Educational', keywords: ['business', 'finance', 'money', 'entrepreneurship', 'investing']),
    Genre(name: 'Health & Fitness', emoji: '💪', category: 'Educational', keywords: ['health', 'fitness', 'workout', 'nutrition', 'wellness']),
    Genre(name: 'Art & Design', emoji: '🎨', category: 'Educational', keywords: ['art', 'design', 'creative', 'drawing', 'painting']),
    Genre(name: 'History & Culture', emoji: '📚', category: 'Educational', keywords: ['history', 'culture', 'ancient', 'civilization', 'heritage']),
    Genre(name: 'Language Learning', emoji: '🗣️', category: 'Educational', keywords: ['language', 'learning', 'speaking', 'vocabulary', 'grammar']),
    Genre(name: 'Psychology', emoji: '🧠', category: 'Educational', keywords: ['psychology', 'mind', 'behavior', 'mental', 'cognitive']),
    Genre(name: 'Philosophy', emoji: '🤔', category: 'Educational', keywords: ['philosophy', 'thinking', 'wisdom', 'ethics', 'logic']),
    
    // Entertainment
    Genre(name: 'Comedy & Humor', emoji: '😂', category: 'Entertainment', keywords: ['comedy', 'humor', 'funny', 'jokes', 'laugh']),
    Genre(name: 'Music & Audio', emoji: '🎵', category: 'Entertainment', keywords: ['music', 'audio', 'songs', 'instruments', 'melody']),
    Genre(name: 'Gaming', emoji: '🎮', category: 'Entertainment', keywords: ['gaming', 'games', 'video games', 'esports', 'streaming']),
    Genre(name: 'Movies & TV', emoji: '🎬', category: 'Entertainment', keywords: ['movies', 'tv', 'cinema', 'films', 'series']),
    Genre(name: 'Sports', emoji: '⚽', category: 'Entertainment', keywords: ['sports', 'football', 'basketball', 'soccer', 'athletics']),
    Genre(name: 'Travel & Adventure', emoji: '✈️', category: 'Entertainment', keywords: ['travel', 'adventure', 'explore', 'vacation', 'journey']),
    Genre(name: 'Food & Cooking', emoji: '🍳', category: 'Entertainment', keywords: ['food', 'cooking', 'recipes', 'cuisine', 'chef']),
    Genre(name: 'Fashion & Beauty', emoji: '💄', category: 'Entertainment', keywords: ['fashion', 'beauty', 'style', 'makeup', 'clothing']),
    
    // Lifestyle
    Genre(name: 'Productivity', emoji: '📈', category: 'Lifestyle', keywords: ['productivity', 'efficiency', 'organization', 'time management', 'goals']),
    Genre(name: 'Relationships', emoji: '💕', category: 'Lifestyle', keywords: ['relationships', 'love', 'dating', 'family', 'friendship']),
    Genre(name: 'Personal Development', emoji: '🌱', category: 'Lifestyle', keywords: ['personal', 'development', 'growth', 'self-improvement', 'motivation']),
    Genre(name: 'Spirituality', emoji: '🧘', category: 'Lifestyle', keywords: ['spirituality', 'meditation', 'mindfulness', 'peace', 'zen']),
    Genre(name: 'DIY & Crafts', emoji: '🔨', category: 'Lifestyle', keywords: ['diy', 'crafts', 'handmade', 'projects', 'creative']),
    Genre(name: 'Pets & Animals', emoji: '🐕', category: 'Lifestyle', keywords: ['pets', 'animals', 'dogs', 'cats', 'wildlife']),
  ];
  int _currentStep = 0;
  int _currentProgress = 0;
  final int _totalSteps = 3;

  final List<OnboardingStep> _onboardingSteps = [
    // Welcome step with value proposition
    OnboardingStep(
      botMessage: "Welcome to Afeedi! 🎉\n\nI'm your AI content curator, here to create a personalized learning experience just for you. In the next 2 minutes, I'll learn about your interests to deliver content that truly matters to you.\n\n✨ Ready to discover amazing content?",
      quickReplies: ["Let's get started! 🚀", "Tell me more 💡"],
      showSkipOption: true,
      stepTitle: "Welcome",
      stepDescription: "Get personalized content recommendations",
    ),
    // Genre selection with progressive disclosure
    OnboardingStep(
      botMessage: "Perfect! Let's start with your interests. 🎯\n\nChoose the topics that excite you most. Don't worry - you can always change these later in your profile.",
      quickReplies: [],
      isGenreSelection: true,
      allowMultiSelect: true,
      stepTitle: "Your Interests",
      stepDescription: "Select topics you'd like to explore",
      helpText: "💡 Tip: Select 3-5 genres for the best personalized experience",
      socialProof: "⭐ Users with personalized interests are 3x more engaged",
    ),
    // Content format with social proof
    OnboardingStep(
      botMessage: "Excellent choices! 📱\n\nNow, what's your preferred content style? Most users love having options for different situations.",
      quickReplies: ["Short & Sweet ⚡", "Long & Detailed 📖", "Mix of Both 🎯"],
      allowTextInput: true,
      inputPlaceholder: "What content length works for you?",
      stepTitle: "Content Style",
      stepDescription: "Choose your preferred format",
      socialProof: "📊 85% of users prefer mixed content for flexibility",
    ),
    // Learning schedule with personalization
    OnboardingStep(
      botMessage: "Almost done! ⏰\n\nWhen do you typically have time to learn? This helps me suggest the perfect content length for each moment.",
      quickReplies: ["Morning Commute 🌅", "Lunch Breaks 🍽️", "Evening Wind-down 🌙", "Weekend Deep-dives 📅"],
      allowTextInput: true,
      inputPlaceholder: "When do you prefer to learn?",
      stepTitle: "Your Schedule",
      stepDescription: "Optimize content for your routine",
      helpText: "🎯 We'll match content length to your available time",
      socialProof: "💯 92% of users say personalized timing improves their learning",
    ),
  ];

  @override
  void initState() {
    super.initState();
    _searchController = TextEditingController();
    _searchFocusNode = FocusNode();
    _filteredGenres = List.from(_allGenres);
    _initializeAnimations();
    _startOnboarding();
  }

  void _initializeAnimations() {
    _fadeController = AnimationController(
      duration: const Duration(milliseconds: 800),
      vsync: this,
    );
    _slideController = AnimationController(
      duration: const Duration(milliseconds: 600),
      vsync: this,
    );
    _typingController = AnimationController(
      duration: const Duration(milliseconds: 1500),
      vsync: this,
    );

    _fadeAnimation = Tween<double>(
      begin: 0.0,
      end: 1.0,
    ).animate(CurvedAnimation(
      parent: _fadeController,
      curve: Curves.easeInOut,
    ));

    _slideAnimation = Tween<Offset>(
      begin: const Offset(0, 0.3),
      end: Offset.zero,
    ).animate(CurvedAnimation(
      parent: _slideController,
      curve: Curves.easeOutCubic,
    ));

    _typingAnimation = Tween<double>(
      begin: 0.0,
      end: 1.0,
    ).animate(CurvedAnimation(
      parent: _typingController,
      curve: Curves.easeInOut,
    ));

    _typingController.repeat(reverse: true);
  }

  void _startOnboarding() {
    Future.delayed(const Duration(milliseconds: 500), () {
      _showBotMessage(_onboardingSteps[0].botMessage);
    });
  }

  void _showBotMessage(String message) {
    setState(() {
      _showTyping = true;
    });

    Future.delayed(const Duration(milliseconds: 2000), () {
      setState(() {
        _showTyping = false;
        _messages.add(ChatMessage(
          text: message,
          isBot: true,
          timestamp: DateTime.now(),
        ));
      });

      _fadeController.forward().then((_) {
        _scrollToBottom();
        if (_currentStep < _onboardingSteps.length) {
          _showQuickRepliesWithDelay();
        }
      });
    });
  }

  void _showQuickRepliesWithDelay() {
    Future.delayed(const Duration(milliseconds: 500), () {
      setState(() {
        _quickReplies.clear();
        _quickReplies.addAll(_onboardingSteps[_currentStep].quickReplies);
        _showQuickReplies = true;
        _showTextInput = _onboardingSteps[_currentStep].allowTextInput;
        _showGenreSelection = _onboardingSteps[_currentStep].isGenreSelection;
        if (_showGenreSelection) {
          _filteredGenres = List.from(_allGenres);
        }
      });
      _slideController.forward();
    });
  }

  void _filterGenres(String query) {
    setState(() {
      _searchQuery = query;
      if (query.isEmpty) {
        _filteredGenres = List.from(_allGenres);
      } else {
        _filteredGenres = _allGenres.where((genre) {
          final searchLower = query.toLowerCase();
          return genre.name.toLowerCase().contains(searchLower) ||
                 genre.category.toLowerCase().contains(searchLower) ||
                 genre.keywords.any((keyword) => keyword.toLowerCase().contains(searchLower));
        }).toList();
      }
    });
  }

  void _toggleGenreSelection(String genreName) {
    setState(() {
      if (_selectedGenres.contains(genreName)) {
        _selectedGenres.remove(genreName);
      } else {
        _selectedGenres.add(genreName);
      }
    });
  }

  void _confirmGenreSelection() {
    if (_selectedGenres.isNotEmpty) {
      final selectedGenresText = _selectedGenres.map((name) {
        final genre = _allGenres.firstWhere((g) => g.name == name);
        return '${genre.emoji} ${genre.name}';
      }).join(', ');
      _handleUserResponse(selectedGenresText);
    }
  }

  void _handleQuickReply(String reply) {
    _handleUserResponse(reply);
  }

  void _handleTextInput() {
    final text = _textController.text.trim();
    if (text.isNotEmpty) {
      _textController.clear();
      _textFocusNode.unfocus();
      _handleUserResponse(text);
    }
  }

  void _handleUserResponse(String response) {
    // Store user preference
    _userPreferences[_currentStep] = response;

    setState(() {
      _messages.add(ChatMessage(
        text: response,
        isBot: false,
        timestamp: DateTime.now(),
      ));
      _showQuickReplies = false;
      _showTextInput = false;
      _showGenreSelection = false;
      _selectedGenres.clear();
      _searchController.clear();
      _currentProgress++;
    });

    _fadeController.reset();
    _slideController.reset();
    _scrollToBottom();

    // Show interactive bot reaction first
    _showBotReaction(response);

    // Check for achievements
    _checkForAchievements(response);
    
    _currentStep++;
    if (_currentStep < _onboardingSteps.length) {
      Future.delayed(const Duration(milliseconds: 2500), () {
        _showBotMessage(_onboardingSteps[_currentStep].botMessage);
      });
    } else {
      Future.delayed(const Duration(milliseconds: 2500), () {
        _showFinalMessage();
      });
    }
  }

  void _showBotReaction(String userResponse) {
    String reaction = _generateBotReaction(userResponse, _currentStep);
    
    Future.delayed(const Duration(milliseconds: 800), () {
      setState(() {
        _showTyping = true;
      });

      Future.delayed(const Duration(milliseconds: 1500), () {
        setState(() {
          _showTyping = false;
          _messages.add(ChatMessage(
            text: reaction,
            isBot: true,
            timestamp: DateTime.now(),
          ));
        });
        _fadeController.forward().then((_) {
          _scrollToBottom();
        });
      });
    });
  }

  String _buildPersonalizedContext() {
    if (_userPreferences.isEmpty) return '';
    
    List<String> contextParts = [];
    
    // Add context based on previous selections
    if (_userPreferences.containsKey(0)) {
      final genres = _userPreferences[0]!;
      if (genres.contains('🎵')) contextParts.add('As a music lover, ');
      if (genres.contains('📚')) contextParts.add('Given your love for books, ');
      if (genres.contains('🎮')) contextParts.add('Since you\'re into gaming, ');
      if (genres.contains('🎬')) contextParts.add('With your interest in movies, ');
    }
    
    return contextParts.isNotEmpty ? contextParts.first : '';
  }
  
  void _checkForAchievements(String response) {
    List<String> newAchievements = [];
    
    // First step achievement
    if (_currentStep == 0 && !_unlockedAchievements.contains('first_step')) {
      newAchievements.add('first_step');
      _experiencePoints += 10;
    }
    
    // Genre explorer achievement
    if (_currentStep == 0 && response.split(',').length >= 3 && !_unlockedAchievements.contains('genre_explorer')) {
      newAchievements.add('genre_explorer');
      _experiencePoints += 25;
    }
    
    // Quick learner achievement
    if (_currentStep == 1 && !_unlockedAchievements.contains('quick_learner')) {
      newAchievements.add('quick_learner');
      _experiencePoints += 15;
    }
    
    // Completion achievement
    if (_currentStep == _onboardingSteps.length - 1 && !_unlockedAchievements.contains('onboarding_complete')) {
      newAchievements.add('onboarding_complete');
      _experiencePoints += 50;
    }
    
    // Show achievement popup if new achievements unlocked
    if (newAchievements.isNotEmpty) {
      _unlockedAchievements.addAll(newAchievements);
      _showAchievementNotification(newAchievements.first);
    }
  }
  
  void _showAchievementNotification(String achievement) {
    String achievementText = _getAchievementText(achievement);
    
    setState(() {
      _currentAchievement = achievementText;
      _showAchievementPopup = true;
    });
    
    // Hide achievement popup after 3 seconds
    Timer(const Duration(seconds: 3), () {
      setState(() {
        _showAchievementPopup = false;
      });
    });
  }
  
  String _getAchievementText(String achievement) {
    switch (achievement) {
      case 'first_step':
        return '🎉 First Step! Welcome to your personalized journey!';
      case 'genre_explorer':
        return '🌟 Genre Explorer! You love variety in your content!';
      case 'quick_learner':
        return '⚡ Quick Learner! You\'re making great progress!';
      case 'onboarding_complete':
        return '🏆 Onboarding Master! You\'re all set for amazing content!';
      default:
        return '✨ Achievement Unlocked!';
    }
  }
  
  String _generateBotReaction(String userResponse, int step) {
    final responses = userResponse.toLowerCase();
    
    // Build personalized context from previous responses
    String personalizedContext = _buildPersonalizedContext();
    
    switch (step) {
      case 0: // Genre selection
        final genreCount = userResponse.split(',').length;
        if (genreCount == 1) {
          return "Perfect choice! ${userResponse.trim()} is an amazing genre. I can already see we're going to curate some fantastic content for you! 🎯";
        } else if (genreCount <= 3) {
          return "Excellent selection! ${userResponse.trim()} - I love the variety! This gives me a great foundation to personalize your content experience. ✨";
        } else {
          return "Wow, you have diverse interests! ${userResponse.trim()} - I'm excited to create a rich, varied content feed that matches all your passions! 🌟";
        }
      
      case 1: // Content format preferences
        if (responses.contains('short')) {
          return "⚡ Quick and engaging! Short-form content is perfect for busy schedules. ${personalizedContext}I'll prioritize bite-sized, impactful videos for you.";
        } else if (responses.contains('long')) {
          return "📖 Deep dives are the best! Long-form content allows for thorough exploration. ${personalizedContext}I'll find you comprehensive, detailed videos.";
        } else {
          return "🎯 Flexible approach! ${personalizedContext}I'll give you a perfect mix of both short and long content based on your mood and available time.";
        }
      
      case 2: // Learning schedule
        if (responses.contains('morning') || responses.contains('commute')) {
          return "🌅 Morning learner! Starting the day with knowledge is amazing. ${personalizedContext}I'll suggest energizing content for your commute.";
        } else if (responses.contains('lunch') || responses.contains('break')) {
          return "🍽️ Perfect lunch break companion! I'll curate content that's just the right length for your break time.";
        } else if (responses.contains('evening') || responses.contains('wind')) {
          return "🌙 Evening wind-down sounds perfect! I'll suggest relaxing yet informative content for your evening routine.";
        } else if (responses.contains('weekend')) {
          return "📅 Weekend deep-dives are the best! I'll save longer, more comprehensive content for your weekend learning sessions.";
        } else {
          return "⏰ I love your learning schedule! I'll make sure to deliver content that fits perfectly into your routine.";
        }
      
      default:
        return "That's really interesting! I'm learning so much about your preferences. 🤖";
    }
  }

  void _showFinalMessage() {
    Future.delayed(const Duration(milliseconds: 1000), () {
      setState(() {
        _showTyping = true;
      });

      Future.delayed(const Duration(milliseconds: 2000), () {
        setState(() {
          _showTyping = false;
          _messages.add(ChatMessage(
            text: "Perfect! I'll personalize your Afeedi experience based on your choices.",
            isBot: true,
            timestamp: DateTime.now(),
          ));
          _currentProgress = _totalSteps;
        });

        _fadeController.forward().then((_) {
          _scrollToBottom();
          Future.delayed(const Duration(milliseconds: 1000), () {
            setState(() {
              _showFinalButton = true;
            });
            _slideController.forward();
          });
        });
      });
    });
  }

  void _scrollToBottom() {
    Future.delayed(const Duration(milliseconds: 100), () {
      if (_scrollController.hasClients) {
        _scrollController.animateTo(
          _scrollController.position.maxScrollExtent,
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeOut,
        );
      }
    });
  }

  @override
  void dispose() {
    _fadeController.dispose();
    _slideController.dispose();
    _typingController.dispose();
    _scrollController.dispose();
    _textController.dispose();
    _textFocusNode.dispose();
    _searchController.dispose();
    _searchFocusNode.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final screenHeight = MediaQuery.of(context).size.height;
    final screenWidth = MediaQuery.of(context).size.width;

    return Scaffold(
      body: Container(
        width: double.infinity,
        height: double.infinity,
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [
              Color(0xFF0D0B1E),
              Color(0xFF2D1B69),
            ],
          ),
        ),
        child: Stack(
          children: [
            // Background blur effects
            Positioned(
              top: screenHeight * 0.15,
              right: -screenWidth * 0.3,
              child: Container(
                width: screenWidth * 0.8,
                height: screenWidth * 0.8,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  gradient: RadialGradient(
                    colors: [
                      const Color(0xFF00D4FF).withOpacity(0.2),
                      const Color(0xFF00D4FF).withOpacity(0.05),
                      Colors.transparent,
                    ],
                  ),
                ),
              ),
            ),
            Positioned(
              bottom: screenHeight * 0.3,
              left: -screenWidth * 0.4,
              child: Container(
                width: screenWidth * 0.9,
                height: screenWidth * 0.9,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  gradient: RadialGradient(
                    colors: [
                      const Color(0xFFFF3C7E).withOpacity(0.15),
                      const Color(0xFFFF3C7E).withOpacity(0.03),
                      Colors.transparent,
                    ],
                  ),
                ),
              ),
            ),
            // Backdrop filter for blur effect
            BackdropFilter(
              filter: ui.ImageFilter.blur(sigmaX: 40, sigmaY: 40),
              child: Container(
                color: Colors.transparent,
              ),
            ),
            // Main content
            SafeArea(
              child: _showWelcomeScreen ? _buildWelcomeScreen() : Column(
                children: [
                  // App bar
                  _buildAppBar(),
                  // Chat messages
                  Expanded(
                    child: _buildChatArea(),
                  ),
                  // Quick replies or final button
                  _buildBottomArea(),
                ],
              ),
            ),
            // Achievement popup overlay
            if (_showAchievementPopup) _buildAchievementPopup(),
          ],
        ),
      ),
    );
  }

  Widget _buildAchievementPopup() {
    return Positioned(
      top: 100,
      left: 20,
      right: 20,
      child: AnimatedOpacity(
        opacity: _showAchievementPopup ? 1.0 : 0.0,
        duration: const Duration(milliseconds: 300),
        child: Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [
                Color(0xFF00D4FF),
                Color(0xFF0099CC),
              ],
            ),
            borderRadius: BorderRadius.circular(16),
            boxShadow: [
              BoxShadow(
                color: const Color(0xFF00D4FF).withOpacity(0.3),
                blurRadius: 20,
                offset: const Offset(0, 10),
              ),
            ],
          ),
          child: Row(
            children: [
              Container(
                width: 50,
                height: 50,
                decoration: BoxDecoration(
                  color: Colors.white.withOpacity(0.2),
                  borderRadius: BorderRadius.circular(25),
                ),
                child: const Icon(
                  Icons.emoji_events,
                  color: Colors.white,
                  size: 28,
                ),
              ),
              const SizedBox(width: 16),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      'Achievement Unlocked!',
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      _currentAchievement,
                      style: TextStyle(
                        color: Colors.white.withOpacity(0.9),
                        fontSize: 14,
                      ),
                    ),
                  ],
                ),
              ),
              Text(
                '+${_getAchievementPoints(_currentAchievement)} XP',
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 14,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
  
  int _getAchievementPoints(String achievement) {
    if (achievement.contains('First Step')) return 10;
    if (achievement.contains('Genre Explorer')) return 25;
    if (achievement.contains('Quick Learner')) return 15;
    if (achievement.contains('Onboarding Master')) return 50;
    return 5;
  }

