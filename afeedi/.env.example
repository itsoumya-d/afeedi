# Afeedi Environment Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Development Supabase (optional - for separate dev environment)
DEV_SUPABASE_URL=https://your-dev-project-id.supabase.co
DEV_SUPABASE_ANON_KEY=your-dev-anon-key-here

# OAuth Configuration
# YouTube/Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook/Instagram OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# TikTok OAuth
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Apple Sign In (iOS)
APPLE_SERVICE_ID=your-apple-service-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# API Keys for Content Aggregation
YOUTUBE_API_KEY=your-youtube-api-key
INSTAGRAM_BASIC_DISPLAY_API_KEY=your-instagram-api-key
TIKTOK_API_KEY=your-tiktok-api-key
FACEBOOK_GRAPH_API_KEY=your-facebook-graph-api-key

# AI/ML Services (optional)
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Analytics and Monitoring
FIREBASE_PROJECT_ID=your-firebase-project-id
SENTRY_DSN=your-sentry-dsn

# Push Notifications
FCM_SERVER_KEY=your-fcm-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id

# Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# App Configuration
APP_NAME=Afeedi
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG_MODE=true

# Security
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Content Moderation
CONTENT_MODERATION_API_KEY=your-content-moderation-api-key
TOXICITY_THRESHOLD=0.7

# Caching
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_URL=https://your-domain.com/webhooks