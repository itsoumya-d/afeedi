      margin: const EdgeInsets.all(8),
      preferBelow: false,
      child: child,
    );
  }

  Widget _buildAppBar() {
    final currentStep = _currentStep < _onboardingSteps.length 
        ? _onboardingSteps[_currentStep] 
        : null;
    
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 16),
      child: Column(
        children: [
          Row(
            children: [
              // Logo
              Container(
                width: 40,
                height: 40,
                decoration: const BoxDecoration(
                  shape: BoxShape.circle,
                  gradient: LinearGradient(
                    begin: Alignment.topCenter,
                    end: Alignment.bottomCenter,
                    colors: [
                      Color(0xFF00D4FF),
                      Color(0xFFFF3C7E),
                    ],
                  ),
                ),
                child: const Icon(
                  Icons.play_arrow,
                  color: Colors.white,
                  size: 20,
                ),
              ),
              const SizedBox(width: 12),
              // Title and description
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      currentStep?.stepTitle ?? 'Afeedi',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 20,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    if (currentStep?.stepDescription != null)
                      Text(
                        currentStep!.stepDescription!,
                        style: TextStyle(
                          fontSize: 14,
                          color: Colors.white.withOpacity(0.8),
                        ),
                      ),
                  ],
                ),
              ),
              // Skip button
              if (currentStep?.showSkipOption == true)
                TextButton(
                  onPressed: () {
                    Navigator.pushReplacementNamed(context, AppRoutes.welcome);
                  },
                  child: Text(
                    'Skip',
                    style: TextStyle(
                      color: Colors.white.withOpacity(0.8),
                      fontSize: 16,
                    ),
                  ),
                ),
              const SizedBox(width: 8),
              // Progress indicator
              _buildTooltip(
          message: 'Track your onboarding progress. Each step personalizes your experience!',
          child: _buildProgressIndicator(),
        ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildProgressIndicator() {
    final progress = (_currentStep + 1) / _onboardingSteps.length;
    final stepsRemaining = _onboardingSteps.length - (_currentStep + 1);
    
    return Column(
      crossAxisAlignment: CrossAxisAlignment.end,
      children: [
        // Progress text
        Text(
          '${_currentStep + 1}/${_onboardingSteps.length}',
          style: TextStyle(
            color: Colors.white.withOpacity(0.8),
            fontSize: 12,
            fontWeight: FontWeight.w500,
          ),
        ),
        const SizedBox(height: 4),
        // Progress bar
        Container(
          width: 80,
          height: 6,
          decoration: BoxDecoration(
            color: Colors.white.withOpacity(0.3),
            borderRadius: BorderRadius.circular(3),
          ),
          child: FractionallySizedBox(
            alignment: Alignment.centerLeft,
            widthFactor: progress,
            child: Container(
              decoration: BoxDecoration(
                gradient: const LinearGradient(
                  colors: [Color(0xFF00D4FF), Color(0xFF0099CC)],
                ),
                borderRadius: BorderRadius.circular(3),
                boxShadow: [
                  BoxShadow(
                    color: const Color(0xFF00D4FF).withOpacity(0.3),
                    blurRadius: 4,
                    offset: const Offset(0, 1),
                  ),
                ],
              ),
            ),
          ),
        ),
        const SizedBox(height: 2),
        // Motivational text
        if (stepsRemaining > 0)
          Text(
            stepsRemaining == 1 ? 'Almost done! 🎉' : '$stepsRemaining steps left',
            style: TextStyle(
              color: Colors.white.withOpacity(0.7),
              fontSize: 10,
            ),
          ),
        else
          Text(
            'Complete! ✨',
            style: TextStyle(
              color: Colors.white.withOpacity(0.9),
              fontSize: 10,
              fontWeight: FontWeight.w600,
            ),
          ),
      ],
    );
  }

  Widget _buildChatArea() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 16),
      child: ListView.builder(
        controller: _scrollController,
        itemCount: _messages.length + (_showTyping ? 1 : 0),
        itemBuilder: (context, index) {
          if (index == _messages.length && _showTyping) {
            return _buildTypingIndicator();
          }
          return _buildMessageBubble(_messages[index]);
        },
      ),
    );
  }

  Widget _buildMessageBubble(ChatMessage message) {
    final currentStep = _currentStep < _onboardingSteps.length 
        ? _onboardingSteps[_currentStep] 
        : null;
    
    return FadeTransition(
      opacity: _fadeAnimation,
      child: Container(
        margin: const EdgeInsets.symmetric(vertical: 8),
        child: Column(
          children: [
            Row(
              mainAxisAlignment:
                  message.isBot ? MainAxisAlignment.start : MainAxisAlignment.end,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                if (message.isBot) ...[
                  // Bot avatar
                  Container(
                    width: 32,
                    height: 32,
                    margin: const EdgeInsets.only(right: 12, top: 4),
                    decoration: const BoxDecoration(
                      shape: BoxShape.circle,
                      gradient: LinearGradient(
                        colors: [Color(0xFF3A0CA3), Color(0xFF7209B7)],
                      ),
                    ),
                    child: const Icon(
                      Icons.smart_toy,
                      color: Colors.white,
                      size: 18,
                    ),
                  ),
                ],
                // Message bubble
                Flexible(
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                    decoration: BoxDecoration(
                      color: message.isBot
                          ? const Color(0xFF3A0CA3)
                          : const Color(0xFF00D4FF),
                      borderRadius: BorderRadius.circular(20),
                      boxShadow: [
                        BoxShadow(
                          color: (message.isBot
                                  ? const Color(0xFF3A0CA3)
                                  : const Color(0xFF00D4FF))
                              .withOpacity(0.3),
                          blurRadius: 8,
                          offset: const Offset(0, 2),
                        ),
                      ],
                    ),
                    child: Text(
                      message.text,
                      style: TextStyle(
                        color: message.isBot ? Colors.white : const Color(0xFF0D0B1E),
                        fontSize: 16,
                        height: 1.5,
                        fontWeight: message.isBot ? FontWeight.w400 : FontWeight.w500,
                        letterSpacing: 0.1,
                      ),
                    ),
                  ),
                ),
                if (!message.isBot)
                  const SizedBox(width: 12),
              ],
            ),
            // Show help text or social proof for bot messages
            if (message.isBot && _messages.isNotEmpty && message == _messages.last) ...[
              if (currentStep?.helpText != null) ...[
                const SizedBox(height: 8),
                Container(
                  margin: const EdgeInsets.only(left: 44),
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                  decoration: BoxDecoration(
                    color: const Color(0xFF00D4FF).withOpacity(0.2),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                      color: const Color(0xFF00D4FF).withOpacity(0.3),
                    ),
                  ),
                  child: Text(
                    currentStep!.helpText!,
                    style: TextStyle(
                      color: Colors.white.withOpacity(0.9),
                      fontSize: 14,
                      fontStyle: FontStyle.italic,
                    ),
                  ),
                ),
              ],
              if (currentStep?.socialProof != null) ...[
                const SizedBox(height: 8),
                Container(
                  margin: const EdgeInsets.only(left: 44),
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                  decoration: BoxDecoration(
                    color: Colors.green.withOpacity(0.2),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                      color: Colors.green.withOpacity(0.3),
                    ),
                  ),
                  child: Text(
                    currentStep!.socialProof!,
                    style: TextStyle(
                      color: Colors.white.withOpacity(0.9),
                      fontSize: 14,
                      fontWeight: FontWeight.w500,
                    ),
                  ),
                ),
              ],
            ],
          ],
        ),
      ),
    );
  }

  Widget _buildTypingIndicator() {
    return Container(
      margin: const EdgeInsets.symmetric(vertical: 8),
      child: Row(
        children: [
          // Bot avatar
          Container(
            width: 32,
            height: 32,
            margin: const EdgeInsets.only(right: 12, top: 4),
            decoration: const BoxDecoration(
              shape: BoxShape.circle,
              gradient: LinearGradient(
                colors: [Color(0xFF3A0CA3), Color(0xFF7209B7)],
              ),
            ),
            child: const Icon(
              Icons.smart_toy,
              color: Colors.white,
              size: 18,
            ),
          ),
          // Typing animation
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
            decoration: BoxDecoration(
              color: const Color(0xFF3A0CA3),
              borderRadius: BorderRadius.circular(20),
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                _buildTypingDot(0),
                const SizedBox(width: 4),
                _buildTypingDot(1),
                const SizedBox(width: 4),
                _buildTypingDot(2),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildTypingDot(int index) {
    return AnimatedBuilder(
      animation: _typingAnimation,
      builder: (context, child) {
        final delay = index * 0.2;
        final animationValue = (_typingAnimation.value + delay) % 1.0;
        final opacity = (animationValue < 0.5)
            ? (animationValue * 2)
            : (2 - animationValue * 2);
        
        return Container(
          width: 6,
          height: 6,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: Colors.white.withOpacity(opacity.clamp(0.3, 1.0)),
          ),
        );
      },
    );
  }

  Widget _buildBottomArea() {
    return Container(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          // Quick replies
          if (_showQuickReplies)
            SlideTransition(
              position: _slideAnimation,
              child: FadeTransition(
                opacity: _fadeAnimation,
                child: Wrap(
                  spacing: 8,
                  runSpacing: 8,
                  children: _quickReplies
                      .map((reply) => _buildQuickReplyChip(reply))
                      .toList(),
                ),
              ),
            ),
          // Genre selection interface
          if (_showGenreSelection && _currentStep < _onboardingSteps.length) ...[
            // Header with motivation
            Container(
              margin: const EdgeInsets.only(top: 16, bottom: 12),
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  colors: [
                    const Color(0xFF00D4FF).withOpacity(0.1),
                    const Color(0xFF0099CC).withOpacity(0.1),
                  ],
                ),
                borderRadius: BorderRadius.circular(16),
                border: Border.all(
                  color: const Color(0xFF00D4FF).withOpacity(0.3),
                ),
              ),
              child: Row(
                children: [
                  Container(
                    padding: const EdgeInsets.all(8),
                    decoration: BoxDecoration(
                      color: const Color(0xFF00D4FF).withOpacity(0.2),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: const Icon(
                      Icons.explore,
                      color: Color(0xFF00D4FF),
                      size: 20,
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        const Text(
                          'Choose Your Interests',
                          style: TextStyle(
                            color: Colors.white,
                            fontSize: 16,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        Text(
                          'Select 3-5 topics for the best experience',
                          style: TextStyle(
                            color: Colors.white.withOpacity(0.7),
                            fontSize: 12,
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
            // Search bar
            Container(
              margin: const EdgeInsets.only(bottom: 16),
              padding: const EdgeInsets.symmetric(horizontal: 16),
              decoration: BoxDecoration(
                color: const Color(0xFF1A1A1A),
                borderRadius: BorderRadius.circular(25),
                border: Border.all(color: const Color(0xFF00D4FF), width: 1),
              ),
              child: Row(
                children: [
                  const Icon(
                    Icons.search,
                    color: Color(0xFF666666),
                    size: 20,
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: TextField(
                      controller: _searchController,
                      focusNode: _searchFocusNode,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 16,
                      ),
                      decoration: const InputDecoration(
                        hintText: 'Search genres (e.g., "S" for Science)...',
                        hintStyle: TextStyle(
                          color: Color(0xFF666666),
                          fontSize: 16,
                        ),
                        border: InputBorder.none,
                        contentPadding: EdgeInsets.symmetric(vertical: 16),
                      ),
                      onChanged: _filterGenres,
                    ),
                  ),
                  if (_searchController.text.isNotEmpty)
                    IconButton(
                      icon: const Icon(
                        Icons.clear,
                        color: Color(0xFF666666),
                        size: 20,
                      ),
                      onPressed: () {
                        _searchController.clear();
                        _filterGenres('');
                      },
                    ),
                ],
              ),
            ),
            // Selected count with progress indicator
            if (_selectedGenres.isNotEmpty)
              Container(
                margin: const EdgeInsets.only(bottom: 16),
                padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    colors: [
                      const Color(0xFF00D4FF).withOpacity(0.2),
                      const Color(0xFF0099CC).withOpacity(0.2),
                    ],
                  ),
                  borderRadius: BorderRadius.circular(20),
                  border: Border.all(color: const Color(0xFF00D4FF).withOpacity(0.3)),
                ),
                child: Row(
                  children: [
                    Icon(
                      _selectedGenres.length >= 3 ? Icons.check_circle : Icons.radio_button_unchecked,
                      color: _selectedGenres.length >= 3 ? Colors.green : const Color(0xFF00D4FF),
                      size: 20,
                    ),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Text(
                        '${_selectedGenres.length} selected${_selectedGenres.length >= 3 ? ' ✨ Perfect!' : ' (${3 - _selectedGenres.length} more recommended)'}',
                        style: TextStyle(
                          color: Colors.white.withOpacity(0.9),
                          fontSize: 14,
                          fontWeight: FontWeight.w500,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
                      
                      // Genre grid
                      _buildTooltip(
                        message: 'Tap to select your favorite content types. Choose at least 3 for better recommendations!',
                        child: Container(
                          constraints: const BoxConstraints(maxHeight: 300),
                          child: SingleChildScrollView(
                            child: Wrap(
                              spacing: 8,
                              runSpacing: 8,
                              children: _filteredGenres.map((genre) {
                              final isSelected = _selectedGenres.contains(genre.name);
                              return GestureDetector(
                                onTap: () => _toggleGenreSelection(genre.name),
                                child: AnimatedContainer(
                                  duration: const Duration(milliseconds: 200),
                                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                                  decoration: BoxDecoration(
                                    color: isSelected ? const Color(0xFF00D4FF).withOpacity(0.2) : const Color(0xFF1A1A1A),
                                    borderRadius: BorderRadius.circular(20),
                                    border: Border.all(
                                      color: isSelected ? const Color(0xFF00D4FF) : const Color(0xFF333333),
                                      width: isSelected ? 2 : 1,
                                    ),
                                  ),
                                  child: Row(
                                    mainAxisSize: MainAxisSize.min,
                                    children: [
                                      Text(
                                        genre.emoji,
                                        style: const TextStyle(fontSize: 18),
                                      ),
                                      const SizedBox(width: 8),
                                      Text(
                                        genre.name,
                                        style: TextStyle(
                                          color: isSelected ? const Color(0xFF00D4FF) : Colors.white,
                                          fontSize: 14,
                                          fontWeight: isSelected ? FontWeight.w600 : FontWeight.w500,
                                        ),
                                      ),
                                      if (isSelected) ...[
                                         const SizedBox(width: 8),
                                         const Icon(
                                           Icons.check_circle,
                                           color: Color(0xFF00D4FF),
                                           size: 16,
                                         ),
                                       ]
                                    ],
                                  ),
                                ),
                              );
                            }).toList(),
                          ),
                        ),
                      ),
                      
                      // Confirm button with enhanced CTA
                      Container(
                        margin: const EdgeInsets.only(top: 16),
                        width: double.infinity,
                        child: ElevatedButton(
                          onPressed: _selectedGenres.isNotEmpty ? _confirmGenreSelection : null,
                          style: ElevatedButton.styleFrom(
                            backgroundColor: _selectedGenres.isNotEmpty 
                                ? const Color(0xFF00D4FF) 
                                : Colors.grey.withOpacity(0.3),
                            foregroundColor: _selectedGenres.isNotEmpty 
                                ? Colors.black 
                                : Colors.white.withOpacity(0.5),
                            shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(25),
                            ),
                            padding: const EdgeInsets.symmetric(vertical: 16),
                            elevation: _selectedGenres.isNotEmpty ? 4 : 0,
                            shadowColor: const Color(0xFF00D4FF).withOpacity(0.3),
                          ),
                          child: Row(
                            mainAxisAlignment: MainAxisAlignment.center,
                            children: [
                              if (_selectedGenres.isNotEmpty) ...[
                                 const Icon(Icons.arrow_forward, size: 20),
                                 const SizedBox(width: 8),
                               ],
                              Text(
                                _selectedGenres.isEmpty
                                    ? 'Select at least one genre'
                                    : 'Continue with ${_selectedGenres.length} genre${_selectedGenres.length == 1 ? '' : 's'} ✨',
                                style: const TextStyle(
                                  fontSize: 16,
                                  fontWeight: FontWeight.w600,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ],
        ),
                    
                    // Text input field with enhanced UX
                    if (_showTextInput && _currentStep < _onboardingSteps.length)
                      AnimatedContainer(
                        duration: const Duration(milliseconds: 300),
                        margin: const EdgeInsets.only(top: 16),
                        padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 4),
                        decoration: BoxDecoration(
                          gradient: LinearGradient(
                            colors: [
                              const Color(0xFF00D4FF).withOpacity(0.3),
                              const Color(0xFFFF3C7E).withOpacity(0.3),
                            ],
                          ),
                          borderRadius: BorderRadius.circular(28),
                        ),
                        child: _buildTooltip(
                          message: 'Type your response here and press send or Enter to continue',
                          child: Container(
                            padding: const EdgeInsets.symmetric(horizontal: 16),
                            decoration: BoxDecoration(
                              color: const Color(0xFF1A1A1A),
                              borderRadius: BorderRadius.circular(24),
                            ),
                            child: Row(
                            children: [
                              Expanded(
                                child: TextField(
                                  controller: _textController,
                                  focusNode: _textFocusNode,
                                  autofocus: true,
                                  style: const TextStyle(
                                    color: Colors.white,
                                    fontSize: 16,
                                    height: 1.4,
                                  ),
                                  decoration: InputDecoration(
                                    hintText: _onboardingSteps[_currentStep].inputPlaceholder ?? 'Type your answer...',
                                    hintStyle: TextStyle(
                                      color: Colors.white.withOpacity(0.5),
                                      fontSize: 16,
                                    ),
                                    border: InputBorder.none,
                                    contentPadding: const EdgeInsets.symmetric(vertical: 16),
                                    prefixIcon: Icon(
                                      Icons.edit_outlined,
                                      color: Colors.white.withOpacity(0.6),
                                      size: 20,
                                    ),
                                  ),
                                  onSubmitted: (_) => _handleTextInput(),
                                  onChanged: (value) {
                                    setState(() {}); // Trigger rebuild for send button state
                                  },
                                  textInputAction: TextInputAction.send,
                                  maxLines: null,
                                  textCapitalization: TextCapitalization.sentences,
                                ),
                              ),
                              const SizedBox(width: 8),
                              AnimatedContainer(
                                duration: const Duration(milliseconds: 200),
                                width: 44,
                                height: 44,
                                decoration: BoxDecoration(
                                  gradient: _textController.text.trim().isNotEmpty
                                      ? const LinearGradient(
                                          colors: [
                                            Color(0xFF00D4FF),
                                            Color(0xFF0099CC),
                                          ],
                                        ),
                                      : null,
                                  color: _textController.text.trim().isEmpty
                                      ? Colors.white.withOpacity(0.1)
                                      : null,
                                  borderRadius: BorderRadius.circular(22),
                                ),
                                child: IconButton(
                                  onPressed: _textController.text.trim().isNotEmpty
                                      ? _handleTextInput
                                      : null,
                                  icon: AnimatedSwitcher(
                                    duration: const Duration(milliseconds: 200),
                                    child: Icon(
                                      _textController.text.trim().isNotEmpty
                                          ? Icons.send_rounded
                                          : Icons.send_outlined,
                                      key: ValueKey(_textController.text.trim().isNotEmpty),
                                      color: _textController.text.trim().isNotEmpty
                                          ? Colors.white
                                          : Colors.white.withOpacity(0.4),
                                      size: 20,
                                    ),
                                  ),
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
          
          // Final button
          if (_showFinalButton)
            SlideTransition(
              position: _slideAnimation,
              child: FadeTransition(
                opacity: _fadeAnimation,
                child: SizedBox(
                  width: double.infinity,
                  height: 52,
                  child: Container(
                    decoration: BoxDecoration(
                      gradient: const LinearGradient(
                        colors: [
                          Color(0xFF00D4FF),
                          Color(0xFF0099CC),
                        ],
                        begin: Alignment.topLeft,
                        end: Alignment.bottomRight,
                      ),
                      borderRadius: BorderRadius.circular(26),
                      boxShadow: [
                        BoxShadow(
                          color: const Color(0xFF00D4FF).withOpacity(0.4),
                          blurRadius: 12,
                          offset: const Offset(0, 4),
                        ),
                      ],
                    ),
                    child: ElevatedButton(
                      onPressed: () {
                        // TODO: Navigate to dashboard
                        Navigator.pushReplacementNamed(context, AppRoutes.welcome);
                      },
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.transparent,
                        foregroundColor: Colors.white,
                        shadowColor: Colors.transparent,
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(26),
                        ),
                        elevation: 0,
                      ),
                      child: Row(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          const Icon(
                            Icons.rocket_launch,
                            size: 20,
                          ),
                          const SizedBox(width: 8),
                          Column(
                            mainAxisAlignment: MainAxisAlignment.center,
                            children: [
                              const Text(
                                'Start Your Personalized Journey',
                                style: TextStyle(
                                  fontSize: 16,
                                  fontWeight: FontWeight.bold,
                                  height: 1.2,
                                ),
                              ),
                              Text(
                                'Join 50,000+ users discovering amazing content',
                                style: TextStyle(
                                  fontSize: 11,
                                  fontWeight: FontWeight.w500,
                                  color: Colors.white.withOpacity(0.9),
                                  height: 1.1,
                                ),
                              ),
                            ],
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
            ),
          ],
        ),
    );
  }

  Widget _buildQuickReplyChip(String text) {
    return AnimatedContainer(
      duration: const Duration(milliseconds: 200),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: () => _handleQuickReply(text),
          borderRadius: BorderRadius.circular(24),
          splashColor: const Color(0xFF00D4FF).withOpacity(0.3),
          highlightColor: const Color(0xFF00D4FF).withOpacity(0.1),
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 200),
            padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 12),
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [
                  const Color(0xFF00D4FF).withOpacity(0.15),
                  const Color(0xFF0099CC).withOpacity(0.15),
                ],
              ),
              borderRadius: BorderRadius.circular(24),
              border: Border.all(
                color: const Color(0xFF00D4FF).withOpacity(0.4),
                width: 1.5,
              ),
              boxShadow: [
                BoxShadow(
                  color: const Color(0xFF00D4FF).withOpacity(0.2),
                  blurRadius: 8,
                  offset: const Offset(0, 2),
                ),
              ],
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                // Extract emoji if present
                 if (text.contains(RegExp(r'[\u{1F600}-\u{1F64F}]|[\u{1F300}-\u{1F5FF}]|[\u{1F680}-\u{1F6FF}]|[\u{1F1E0}-\u{1F1FF}]|[\u{2600}-\u{26FF}]|[\u{2700}-\u{27BF}]', unicode: true))) ...[
                    Text(
                      text.split(' ').firstWhere((part) => part.contains(RegExp(r'[\u{1F600}-\u{1F64F}]|[\u{1F300}-\u{1F5FF}]|[\u{1F680}-\u{1F6FF}]|[\u{1F1E0}-\u{1F1FF}]|[\u{2600}-\u{26FF}]|[\u{2700}-\u{27BF}]', unicode: true)), orElse: () => ''),
                      style: const TextStyle(fontSize: 16),
                    ),
                    const SizedBox(width: 8),
                  ],
                Flexible(
                  child: Text(
                    text.replaceAll(RegExp(r'[\u{1F600}-\u{1F64F}]|[\u{1F300}-\u{1F5FF}]|[\u{1F680}-\u{1F6FF}]|[\u{1F1E0}-\u{1F1FF}]|[\u{2600}-\u{26FF}]|[\u{2700}-\u{27BF}]', unicode: true), '').trim(),
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 15,
                      fontWeight: FontWeight.w600,
                      height: 1.2,
                    ),
                    textAlign: TextAlign.center,
                  ),
                ),
                const SizedBox(width: 4),
                Icon(
                  Icons.arrow_forward_ios,
                  color: Colors.white.withOpacity(0.7),
                  size: 12,
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class ChatMessage {
  final String text;
  final bool isBot;
  final DateTime timestamp;

  ChatMessage({
    required this.text,
    required this.isBot,
    required this.timestamp,
  });
}

class Genre {
  final String name;
  final String emoji;
  final String category;
  final List<String> keywords;

  Genre({
    required this.name,
    required this.emoji,
    required this.category,
    required this.keywords,
  });
}

class OnboardingStep {
  final String botMessage;
  final List<String> quickReplies;
  final bool allowTextInput;
  final String? inputPlaceholder;
  final bool isGenreSelection;
  final bool allowMultiSelect;
  final bool showSkipOption;
  final String? stepTitle;
  final String? stepDescription;
  final String? helpText;
  final String? socialProof;

  OnboardingStep({
    required this.botMessage,
    required this.quickReplies,
    this.allowTextInput = false,
    this.inputPlaceholder,
    this.isGenreSelection = false,
    this.allowMultiSelect = false,
    this.showSkipOption = false,
    this.stepTitle,
    this.stepDescription,
    this.helpText,
    this.socialProof,
  });
}